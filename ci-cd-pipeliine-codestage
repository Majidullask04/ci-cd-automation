pipeline {
    agent any
    
    tools {
        nodejs 'nodejs26'
    }
    
    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {
        stage('git-checkout') {
            steps {
                git branch: 'k3s-local', url: 'https://github.com/Majidullask04/3-Tier-DevSecOps-Mega-Project.git'
            }
        }
        
        stage('frontent-compilation') {
            steps {
                dir('client') {
                    sh 'find . -name "*.js" -exec node --check {} +'
               }
            }
        }
        stage('backend-compilation') {
            steps {
                dir('api') {
                    sh 'find . -name "*.js" -exec node --check {} +'
               }
            }
        }
        
        stage('gitleaks') {
            steps {
                sh 'gitleaks detect --source ./client --exit-code 1'
                sh 'gitleaks detect --source ./api --exit-code 1'
            }
        }
        
        stage('sonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                  sh ''' $SCANNER_HOME/bin/sonar-scanner -Dsonar.projectName=Nodejs-project \
                  -Dsonar.projectKey=nodejs-project '''
                }
            }
        }
        
        stage('Quality Gate check') {
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-tocken'
                }
            }
        }
        
        stage('Trivy FS Scan') {
            steps {
                sh 'trivy fs --format table -o fs-report.html .'
            }
        }
        
        stage('Build-Tag & Push Backend docker image') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-id') {
                        dir('api') {
                         sh 'docker build -t majid04/backend:latest .'
                         sh 'trivy image --format table -o backend-image-report.html majid04/backend:latest '
                         sh 'docker push majid04/backend:latest'
                      }
                   }
                }
            }
        }
        
        stage('Build-Tag & Push Frontent docker image') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-id') {
                        dir('client') {
                         sh 'docker build -t majid04/frontent:latest .'
                         sh 'trivy image --format table -o frontent-image-report.html majid04/frontent:latest '
                         sh 'docker push majid04/frontent:latest'
                      }
                   }
                }
            }
        }
        
        stage('Deploy To Kubernetes') {
            steps {
               sh 'kubectl apply -f k8s-prod/'
                }
            }
        }
    }

